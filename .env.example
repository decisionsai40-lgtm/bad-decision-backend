# ============================================================
# BAD DECISION AI — Environment Variables Template
# ============================================================
# COPY this file and rename it to ".env"
# Then fill in your real values (never share these!)
# ============================================================

# Supabase (Get these from: Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# DeepSeek AI (Get this from: platform.deepseek.com → API Keys)
# You can put multiple keys separated by commas for rate-limit protection
DEEPSEEK_API_KEYS=your-deepseek-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here

# Server Settings
PORT=8000
DEBUG=false
