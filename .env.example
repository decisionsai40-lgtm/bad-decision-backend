# ============================================================
# BAD DECISION AI — Backend Environment Variables
# Copy this to .env for local development.
# On Render, add these in Environment settings.
# ============================================================

# ---- SUPABASE (Database) ----
# Get these from https://supabase.com/dashboard → Project Settings → API
# SUPABASE_KEY = the "service_role" key (secret, full admin access)
# SUPABASE_ANON_KEY = the "anon" key (public, limited by RLS)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- BACKEND API SECRET ----
# A shared secret between the Next.js frontend and this backend.
# MUST be the same value as BACKEND_API_SECRET on Vercel.
# Make up a strong random string — e.g. "bd-2024-s3cr3t-k3y-x9z"
BACKEND_API_SECRET=your_shared_secret_here

# ---- DEEPSEEK (AI Search Engine) ----
# Get from https://platform.deepseek.com/api_keys
# You can use a single key or multiple keys separated by commas.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx
DEEPSEEK_API_KEYS=sk-key1,sk-key2,sk-key3

# ---- PORT (set automatically by Render) ----
PORT=8000
